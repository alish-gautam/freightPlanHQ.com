---
import { site } from '../lib/site';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const allItems = [{ label: 'Home', href: '/' }, ...items];

const schemaItems = allItems.map((item, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: item.label,
  ...(item.href ? { item: item.href.startsWith('http') ? item.href : `${site.url}${item.href}` } : {}),
}));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: schemaItems,
};
---

<nav aria-label="Breadcrumb" class="py-3 text-xs text-mute">
  <ol class="flex items-center gap-1.5 p-0 m-0 list-none flex-wrap">
    {allItems.map((item, idx) => {
      const isLast = idx === allItems.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {idx > 0 && <span class="text-mute/60 font-mono text-[10px]" aria-hidden="true">/</span>}
          {isLast || !item.href ? (
            <span class="text-ink font-semibold truncate max-w-[260px] sm:max-w-none" aria-current={isLast ? 'page' : undefined}>
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="text-body hover:text-ink transition-colors no-underline font-medium flex items-center gap-1">
              {idx === 0 && (
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                  <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
              )}
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
