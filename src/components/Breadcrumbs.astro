---
import { site } from '../lib/site';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const allItems = [{ label: 'Home', href: '/' }, ...items];

const schemaItems = allItems.map((item, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: item.label,
  ...(item.href ? { item: item.href.startsWith('http') ? item.href : `${site.url}${item.href}` } : {}),
}));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: schemaItems,
};
---

<nav aria-label="Breadcrumb" class="py-3 text-xs text-gray-500">
  <ol class="flex items-center gap-1.5 p-0 m-0 list-none flex-wrap">
    {allItems.map((item, idx) => {
      const isLast = idx === allItems.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {idx > 0 && <span class="text-gray-300" aria-hidden="true">/</span>}
          {isLast || !item.href ? (
            <span class="text-gray-900 font-medium" aria-current={isLast ? 'page' : undefined}>
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="text-gray-500 hover:text-gray-900 transition-colors no-underline">
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
