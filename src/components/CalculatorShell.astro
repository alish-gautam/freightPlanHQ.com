---
import type { CalculatorSpec, Values, RowValues } from '../lib/calculators/types';
import { sectionsHtml } from '../lib/calculators/form-html';
import { resultHtml } from '../lib/calculators/result-html';

export interface Props {
  slug: string;
  spec: CalculatorSpec;
}

const { slug, spec } = Astro.props;

// Compute SSR initial defaults
function extractDefaults(spec: CalculatorSpec): Values {
  const values: Values = {};
  for (const s of spec.sections) {
    for (const f of s.fields) {
      if (f.kind === 'number') {
        values[f.id] = f.default !== undefined && f.default !== '' ? Number(f.default) : null;
      } else if (f.kind === 'select') {
        values[f.id] = f.default;
      } else if (f.kind === 'check') {
        values[f.id] = f.default;
      } else if (f.kind === 'rows') {
        values[f.id] = f.defaults.map((d) => {
          const row: RowValues = {};
          for (const c of f.columns) {
            const raw = d[c.id];
            row[c.id] = raw !== undefined ? (c.kind === 'number' ? Number(raw) : String(raw)) : null;
          }
          return row;
        });
      }
    }
  }
  return values;
}

const defaultValues = extractDefaults(spec);
const initialResult = spec.compute(defaultValues);
const initialFormHtml = sectionsHtml(spec.sections);
const initialResultHtml = resultHtml(initialResult);
---

<div class="calculator-shell border border-hairline rounded-xl bg-canvas-elevated p-5 sm:p-7 shadow-xs my-6 transition-colors" data-calculator-shell data-calculator-slug={slug}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
    <!-- Left Column: Form Specifications -->
    <div class="lg:col-span-7 space-y-6">
      <form data-calculator-form onsubmit="return false;" novalidate>
        <h2 class="sr-only">Calculator Inputs</h2>
        <div set:html={initialFormHtml} />

        <div class="flex items-center justify-between pt-4 border-t border-hairline mt-6">
          <button type="button" class="btn btn-secondary btn-sm" data-reset-calc>
            Reset Form
          </button>
          <span class="text-xs text-mute font-mono flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>
            Instant client calculation
          </span>
        </div>
      </form>
    </div>

    <!-- Right Column: Result Panel (Sticky on large screens) -->
    <div class="lg:col-span-5 lg:sticky lg:top-24 space-y-4">
      <div class="bg-surface-result border border-hairline rounded-xl p-5 sm:p-6 transition-colors shadow-xs">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-hairline">
          <div>
            <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-accent block mb-0.5">
              Precision Output
            </span>
            <h2 class="text-sm font-bold text-ink m-0">
              Live Calculation Results
            </h2>
          </div>
          <button
            type="button"
            class="btn btn-secondary btn-sm text-xs font-mono"
            data-copy-result
            aria-label="Copy Result to clipboard"
          >
            Copy Result
          </button>
        </div>

        <div id="calc-result-target" aria-live="polite">
          <div set:html={initialResultHtml} />
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { getCalculatorBySlug } from '../lib/calculators/registry';
  import { initCalculator } from '../lib/calculators/client-runner';

  function setup() {
    document.querySelectorAll<HTMLElement>('[data-calculator-shell]').forEach((root) => {
      if (root.dataset.initialized) return;
      root.dataset.initialized = 'true';
      const slug = root.dataset.calculatorSlug;
      if (!slug) return;
      const calc = getCalculatorBySlug(slug);
      if (calc) {
        initCalculator(calc.spec, root);
      }
    });
  }

  // Setup on initial load
  setup();

  // Support potential client-side navigation or re-renders
  document.addEventListener('astro:page-load', setup);
</script>
