---
import { site } from '../lib/site';
import BrandIcon from './BrandIcon.astro';
---

<footer class="border-t border-hairline bg-canvas-elevated text-body text-xs mt-auto transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-8 mb-12">
      <!-- Col 1: Brand & Purpose -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2.5 text-ink font-bold tracking-tight text-base mb-3 no-underline group">
          <div class="w-8 h-8 rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-950 flex items-center justify-center p-1 shadow-xs border border-hairline">
            <BrandIcon size={20} />
          </div>
          <span>Freight<span class="text-blue-600 dark:text-blue-400">Plan</span><span class="text-xs uppercase text-mute">HQ</span></span>
        </a>
        <p class="text-xs text-mute leading-relaxed max-w-sm mb-3">
          A dedicated freight and packaging planning utility platform. Engineered for exporters, importers, warehouse managers, and shipping coordinators preparing cargo prior to requesting carrier quotations.
        </p>
        <p class="text-[11px] text-mute font-mono">
          Strictly distinguishes pure mathematical calculation from planning estimates and carrier tariff rules.
        </p>
      </div>

      <!-- Col 2: Freight & Pallets -->
      <div>
        <p class="font-bold text-[11px] text-ink uppercase tracking-wider mb-3">Freight & Pallets</p>
        <ul class="space-y-2 list-none p-0 m-0 text-xs">
          <li><a href="/freight-class-calculator/" class="text-body hover:text-ink no-underline transition-colors">Freight Class</a></li>
          <li><a href="/cbm-calculator/" class="text-body hover:text-ink no-underline transition-colors">CBM Volume</a></li>
          <li><a href="/freight-density-calculator/" class="text-body hover:text-ink no-underline transition-colors">Freight Density</a></li>
          <li><a href="/pallet-calculator/" class="text-body hover:text-ink no-underline transition-colors">Pallet Stacking (TI×HI)</a></li>
          <li><a href="/pallets-per-container-calculator/" class="text-body hover:text-ink no-underline transition-colors">Pallets Per Container</a></li>
        </ul>
      </div>

      <!-- Col 3: Packaging & Air/Ocean -->
      <div>
        <p class="font-bold text-[11px] text-ink uppercase tracking-wider mb-3">Packaging & Modes</p>
        <ul class="space-y-2 list-none p-0 m-0 text-xs">
          <li><a href="/dimensional-weight-calculator/" class="text-body hover:text-ink no-underline transition-colors">Dimensional Weight</a></li>
          <li><a href="/box-size-calculator/" class="text-body hover:text-ink no-underline transition-colors">Box Sizing</a></li>
          <li><a href="/box-volume-calculator/" class="text-body hover:text-ink no-underline transition-colors">Box Volume</a></li>
          <li><a href="/package-girth-calculator/" class="text-body hover:text-ink no-underline transition-colors">Package Girth</a></li>
          <li><a href="/air-freight-chargeable-weight-calculator/" class="text-body hover:text-ink no-underline transition-colors">Air Chargeable Weight</a></li>
          <li><a href="/lcl-freight-calculator/" class="text-body hover:text-ink no-underline transition-colors">Ocean LCL (W/M)</a></li>
        </ul>
      </div>

      <!-- Col 4: Containers & Equipment -->
      <div>
        <p class="font-bold text-[11px] text-ink uppercase tracking-wider mb-3">Equipment</p>
        <ul class="space-y-2 list-none p-0 m-0 text-xs">
          <li><a href="/container-loading-calculator/" class="text-body hover:text-ink no-underline transition-colors">Container Loading (3D)</a></li>
          <li><a href="/loading-meter-calculator/" class="text-body hover:text-ink no-underline transition-colors">Loading Meters (LDM)</a></li>
          <li><a href="/linear-feet-calculator/" class="text-body hover:text-ink no-underline transition-colors">Trailer Linear Feet</a></li>
          <li><a href="/guides/" class="text-body hover:text-ink no-underline transition-colors">Reference Guides</a></li>
        </ul>
      </div>

      <!-- Col 5: Standards & Trust -->
      <div>
        <p class="font-bold text-[11px] text-ink uppercase tracking-wider mb-3">Standards & Legal</p>
        <ul class="space-y-2 list-none p-0 m-0 text-xs">
          <li><a href="/methodology/" class="text-body hover:text-ink no-underline transition-colors">Methodology</a></li>
          <li><a href="/sources/" class="text-body hover:text-ink no-underline transition-colors">Source Registry</a></li>
          <li><a href="/about/" class="text-body hover:text-ink no-underline transition-colors">About Us</a></li>
          <li><a href="/contact/" class="text-body hover:text-ink no-underline transition-colors">Contact</a></li>
          <li><a href="/disclaimer/" class="text-body hover:text-ink no-underline transition-colors">Disclaimer</a></li>
          <li><a href="/privacy/" class="text-body hover:text-ink no-underline transition-colors">Privacy Policy</a></li>
          <li><a href="/terms/" class="text-body hover:text-ink no-underline transition-colors">Terms of Use</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-hairline pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-mute gap-4">
      <p class="m-0">
        {site.copyright}. All calculation logic is deterministic and client-executed.
      </p>
      <p class="m-0 text-center sm:text-right text-[11px] text-mute">
        Not an official NMFC tariff, freight brokerage, carrier booking platform, or legal compliance authority.
      </p>
    </div>
  </div>
</footer>
