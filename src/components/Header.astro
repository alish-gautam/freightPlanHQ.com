---
import { BRAND_NAME } from '../lib/site';
import BrandIcon from './BrandIcon.astro';

const navItems = [
  { label: 'Freight', href: '/freight-class-calculator/' },
  { label: 'Pallets', href: '/pallet-calculator/' },
  { label: 'Packaging', href: '/dimensional-weight-calculator/' },
  { label: 'Air & Ocean', href: '/air-freight-chargeable-weight-calculator/' },
  { label: 'Containers & Trailers', href: '/container-loading-calculator/' },
  { label: 'Guides', href: '/guides/' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-canvas-elevated/95 backdrop-blur-md border-b border-hairline transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-18 flex items-center justify-between">
    <!-- Brand Logo Treatment -->
    <a
      href="/"
      class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg"
      id="logo"
    >
      <div class="rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-950 flex items-center justify-center p-1.5 shadow-xs transition-transform group-hover:scale-105 shrink-0 w-10 h-10 border border-hairline">
        <BrandIcon size={24} />
      </div>
      <span class="font-bold text-xl tracking-tight text-ink">
        Freight<span class="text-blue-600 dark:text-blue-400">Plan</span><span class="text-xs font-semibold uppercase tracking-wider text-mute ml-0.5">HQ</span>
      </span>
      <span class="hidden lg:inline-block text-[10px] font-mono font-semibold uppercase tracking-wider bg-surface-subtle text-mute px-2 py-0.5 rounded border border-hairline">
        Planning Utility
      </span>
    </a>

    <!-- Desktop Navigation & Controls -->
    <div class="flex items-center gap-2 sm:gap-4">
      <nav class="hidden md:flex items-center gap-1" aria-label="Main Navigation">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`inline-flex min-h-10 items-center text-xs lg:text-sm font-semibold px-3 py-1.5 rounded-lg transition-colors no-underline ${
                isActive
                  ? 'bg-surface-subtle text-ink font-bold'
                  : 'text-body hover:text-ink hover:bg-surface-subtle'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Theme Toggle Component -->
      <button
        type="button"
        id="theme-toggle"
        class="w-10 h-10 rounded-lg border border-hairline bg-canvas flex items-center justify-center text-mute hover:text-ink hover:bg-surface-subtle transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label="Switch to dark mode"
        title="Switch to dark mode"
      >
        <span id="theme-toggle-dark-icon" class="hidden">
          <!-- Moon Icon for switching to dark mode -->
          <svg class="w-4 h-4 text-slate-400 hover:text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </span>
        <span id="theme-toggle-light-icon" class="hidden">
          <!-- Sun Icon for switching to light mode -->
          <svg class="w-4 h-4 text-amber-500 hover:text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </span>
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="inline-flex md:hidden w-10 h-10 items-center justify-center rounded-lg border border-hairline bg-canvas text-mute hover:text-ink hover:bg-surface-subtle transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-bars" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-hairline bg-canvas-elevated">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold transition-colors text-body hover:bg-surface-subtle hover:text-ink no-underline"
        >
          {item.label}
        </a>
      ))}
      <div class="border-t border-hairline my-2 pt-2"></div>
      <a href="/methodology/" class="flex min-h-10 items-center rounded-lg px-3 text-xs font-medium text-mute hover:text-ink hover:bg-surface-subtle no-underline">
        Calculation Methodology
      </a>
      <a href="/sources/" class="flex min-h-10 items-center rounded-lg px-3 text-xs font-medium text-mute hover:text-ink hover:bg-surface-subtle no-underline">
        Source Standards
      </a>
      <a href="/about/" class="flex min-h-10 items-center rounded-lg px-3 text-xs font-medium text-mute hover:text-ink hover:bg-surface-subtle no-underline">
        About {BRAND_NAME}
      </a>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    // Theme toggle logic
    const themeBtn = document.getElementById('theme-toggle');
    const darkIcon = document.getElementById('theme-toggle-dark-icon');
    const lightIcon = document.getElementById('theme-toggle-light-icon');

    function updateIcons(isDark: boolean) {
      if (!darkIcon || !lightIcon || !themeBtn) return;
      if (isDark) {
        darkIcon.classList.add('hidden');
        lightIcon.classList.remove('hidden');
        themeBtn.setAttribute('aria-label', 'Switch to light mode');
        themeBtn.setAttribute('title', 'Switch to light mode');
        themeBtn.setAttribute('aria-pressed', 'true');
      } else {
        lightIcon.classList.add('hidden');
        darkIcon.classList.remove('hidden');
        themeBtn.setAttribute('aria-label', 'Switch to dark mode');
        themeBtn.setAttribute('title', 'Switch to dark mode');
        themeBtn.setAttribute('aria-pressed', 'false');
      }
      const meta = document.getElementById('meta-theme-color');
      if (meta) {
        meta.setAttribute('content', isDark ? '#090d16' : '#f8fafc');
      }
    }

    if (themeBtn && darkIcon && lightIcon) {
      updateIcons(document.documentElement.classList.contains('dark'));

      themeBtn.onclick = () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (_) {}
        updateIcons(isDark);
      };

      // Listen for system preference changes when not manually pinned
      window.addEventListener('theme-changed', ((e: CustomEvent) => {
        if (e.detail && typeof e.detail.isDark === 'boolean') {
          updateIcons(e.detail.isDark);
        }
      }) as EventListener);
    }

    // Mobile menu toggle logic
    const menuBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');

    function closeMobileMenu() {
      if (!menuBtn || !mobileMenu || !iconBars || !iconClose) return;
      menuBtn.setAttribute('aria-expanded', 'false');
      menuBtn.setAttribute('aria-label', 'Open navigation menu');
      mobileMenu.classList.add('hidden');
      iconBars.classList.remove('hidden');
      iconClose.classList.add('hidden');
    }

    if (menuBtn && mobileMenu && iconBars && iconClose) {
      menuBtn.onclick = () => {
        const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          closeMobileMenu();
        } else {
          menuBtn.setAttribute('aria-expanded', 'true');
          menuBtn.setAttribute('aria-label', 'Close navigation menu');
          mobileMenu.classList.remove('hidden');
          iconBars.classList.add('hidden');
          iconClose.classList.remove('hidden');
        }
      };

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
          closeMobileMenu();
          menuBtn.focus();
        }
      });
    }
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
  document.addEventListener('astro:after-swap', setupHeader);
</script>
