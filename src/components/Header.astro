---
import { BRAND_NAME } from '../lib/site';

const navItems = [
  { label: 'Freight', href: '/freight-class-calculator/' },
  { label: 'Pallets', href: '/pallet-calculator/' },
  { label: 'Packaging', href: '/dimensional-weight-calculator/' },
  { label: 'Air & Ocean', href: '/air-freight-chargeable-weight-calculator/' },
  { label: 'Containers', href: '/container-loading-calculator/' },
  { label: 'Guides', href: '/guides/' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-gray-200 bg-white sticky top-0 z-40">
  <div class="container-wide flex items-center justify-between h-16">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2 text-gray-900 no-underline font-semibold tracking-tight text-lg group">
        <span class="w-7 h-7 rounded bg-gray-950 text-white flex items-center justify-center font-mono text-xs font-bold shadow-sm">
          FP
        </span>
        <span class="flex items-center gap-1.5">
          <span>{BRAND_NAME}</span>
          <span class="hidden sm:inline-block text-[10px] font-mono tracking-wider uppercase text-gray-500 bg-gray-100 border border-gray-200 px-1.5 py-0.5 rounded font-medium">
            Utility
          </span>
        </span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors no-underline ${
              isActive
                ? 'bg-gray-100 text-gray-950 font-semibold'
                : 'text-gray-600 hover:text-gray-950 hover:bg-gray-50'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Mobile Navigation Toggle -->
    <div class="flex items-center md:hidden">
      <details class="relative">
        <summary class="list-none p-2 rounded-md border border-gray-200 text-gray-700 hover:bg-gray-50 cursor-pointer" aria-label="Toggle navigation menu">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 w-56 bg-white border border-gray-200 rounded-lg shadow-lg py-2 z-50">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-950 no-underline"
            >
              {item.label}
            </a>
          ))}
          <div class="border-t border-gray-100 my-1"></div>
          <a href="/methodology/" class="block px-4 py-2 text-xs text-gray-500 hover:text-gray-900 no-underline">
            Calculation Methodology
          </a>
          <a href="/sources/" class="block px-4 py-2 text-xs text-gray-500 hover:text-gray-900 no-underline">
            Source Standards
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
