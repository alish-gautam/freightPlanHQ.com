---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CalculatorShell from '../components/CalculatorShell.astro';
import { calculators, type CalculatorMeta } from '../lib/calculators/registry';
import { getGuideBySlug, type GuideMeta } from '../lib/guides/registry';
import { sourceById } from '../lib/sources';
import { site } from '../lib/site';

export function getStaticPaths() {
  return calculators.map((calc) => ({
    params: { slug: calc.slug },
    props: { calc },
  }));
}

export interface Props {
  calc: CalculatorMeta;
}

const { calc } = Astro.props;

// Prepare Schema.org JSON-LD
const webAppSchema = {
  '@type': 'WebApplication',
  name: calc.title,
  url: `${site.url}${calc.path}`,
  description: calc.metaDescription,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const faqSchema = calc.faqs.length
  ? {
      '@type': 'FAQPage',
      mainEntity: calc.faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    }
  : null;

const fullSchema = [webAppSchema, ...(faqSchema ? [faqSchema] : [])];

// Resolve related entities
const relatedCalcs = calc.relatedCalculators
  .map((slug) => calculators.find((c) => c.slug === slug))
  .filter((c): c is CalculatorMeta => Boolean(c));

const relatedGuides = calc.relatedGuides
  .map((slug) => getGuideBySlug(slug))
  .filter((g): g is GuideMeta => Boolean(g));

const resolvedSources = calc.sourceIds
  .map((id) => {
    try {
      return sourceById(id);
    } catch {
      return null;
    }
  })
  .filter(Boolean);
---

<Layout
  title={calc.metaTitle}
  description={calc.metaDescription}
  canonicalPath={calc.slug}
  schema={fullSchema}
>
  <div class="container-narrow py-6 sm:py-10">
    <!-- Breadcrumb -->
    <Breadcrumbs
      items={[
        { label: calc.category, href: `/#category-${calc.category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` },
        { label: calc.title },
      ]}
    />

    <!-- Header Block -->
    <header class="mt-4 mb-6">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-gray-100 border border-gray-200 text-xs font-mono text-gray-700 uppercase tracking-wider mb-3">
        <span>{calc.category}</span>
        {calc.flagship && <span class="bg-blue-600 text-white px-1.5 py-0.2 rounded font-semibold text-[10px]">Flagship</span>}
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-gray-950 mb-3">
        {calc.h1}
      </h1>
      <p class="text-base text-gray-600 leading-relaxed max-w-3xl m-0">
        {calc.shortDesc}
      </p>
    </header>

    <!-- Calculator Shell (Placed EARLY per Section 39) -->
    <CalculatorShell slug={calc.slug} spec={calc.spec} />

    <!-- Technical Contextual Disclaimer -->
    <div class="border-l-4 border-amber-500 bg-amber-50 p-4 rounded-r-md text-xs text-amber-900 leading-relaxed my-8" role="note">
      <p class="font-semibold uppercase tracking-wider text-[11px] text-amber-800 m-0 mb-1">
        Planning Notice & Disclaimer
      </p>
      <p class="m-0">
        {calc.disclaimer}
      </p>
    </div>

    <!-- Formula & Methodology -->
    <section class="mt-12 pt-8 border-t border-gray-200">
      <h2 class="text-xl font-bold text-gray-950 tracking-tight mb-3">
        Formula & Calculation Methodology
      </h2>
      <p class="text-sm text-gray-700 leading-relaxed mb-4">
        {calc.formula.summary}
      </p>

      <div class="bg-gray-900 text-gray-100 rounded-lg p-4 font-mono text-sm overflow-x-auto my-4 shadow-xs">
        <code>{calc.formula.latexOrCode}</code>
      </div>

      <div class="table-scroll">
        <table class="data-table">
          <caption>Variable Definitions</caption>
          <thead>
            <tr>
              <th scope="col">Variable</th>
              <th scope="col">Definition & Unit Basis</th>
            </tr>
          </thead>
          <tbody>
            {calc.formula.variables.map((v) => (
              <tr>
                <th scope="row" class="font-mono">{v.symbol}</th>
                <td>{v.explanation}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Worked Example (Reproducible arithmetic matching engine) -->
    <section class="mt-12 pt-8 border-t border-gray-200">
      <h2 class="text-xl font-bold text-gray-950 tracking-tight mb-3">
        Worked Example: {calc.workedExample.title}
      </h2>
      <p class="text-sm text-gray-700 leading-relaxed mb-4">
        {calc.workedExample.scenario}
      </p>

      <div class="bg-white border border-gray-200 rounded-lg p-5 mb-4 shadow-xs">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3">
          Example Inputs
        </h3>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-2 list-none p-0 m-0 text-xs">
          {calc.workedExample.inputs.map((inp) => (
            <li class="bg-gray-50 p-2.5 rounded border border-gray-100">
              <span class="block text-gray-500 text-[11px]">{inp.label}</span>
              <span class="font-semibold text-gray-900">{inp.value}</span>
            </li>
          ))}
        </ul>

        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mt-5 mb-2">
          Step-by-Step Calculation
        </h3>
        <ol class="space-y-1.5 text-xs text-gray-700 pl-4 m-0">
          {calc.workedExample.steps.map((st) => (
            <li>{st}</li>
          ))}
        </ol>

        <div class="mt-5 p-3.5 bg-blue-50 border border-blue-200 rounded-md">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-blue-700 m-0 mb-0.5">
            Verified Result: {calc.workedExample.result.label}
          </p>
          <p class="text-lg font-bold text-blue-950 m-0">
            {calc.workedExample.result.value}
          </p>
          {calc.workedExample.result.note && (
            <p class="text-xs text-blue-800 m-0 mt-1">
              {calc.workedExample.result.note}
            </p>
          )}
        </div>
      </div>
    </section>

    <!-- Assumptions & Important Limitations -->
    <section class="mt-12 pt-8 border-t border-gray-200 grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h2 class="text-lg font-bold text-gray-950 tracking-tight mb-3">
          Assumptions Used
        </h2>
        <ul class="space-y-2 text-xs text-gray-700 pl-4 m-0">
          {calc.assumptions.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-lg font-bold text-gray-950 tracking-tight mb-3">
          Important Limitations
        </h2>
        <ul class="space-y-2 text-xs text-gray-700 pl-4 m-0">
          {calc.limitations.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Authoritative Sources -->
    {resolvedSources.length > 0 && (
      <section class="mt-12 pt-8 border-t border-gray-200">
        <h2 class="text-lg font-bold text-gray-950 tracking-tight mb-3">
          Authoritative Standards & Sources
        </h2>
        <div class="space-y-3">
          {resolvedSources.map((s) => (
            <div class="border border-gray-200 rounded-lg p-4 bg-white text-xs">
              <div class="flex items-center justify-between mb-1">
                <span class="font-semibold text-gray-900">{s!.organization}</span>
                <span class="text-gray-400 font-mono text-[11px]">Verified: {s!.verified}</span>
              </div>
              <p class="text-gray-700 font-medium mb-1">
                <a href={s!.url} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
                  {s!.title} ↗
                </a>
              </p>
              <p class="text-gray-500 m-0 text-[11px]">
                {s!.notes}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Frequently Asked Questions -->
    {calc.faqs.length > 0 && (
      <section class="mt-12 pt-8 border-t border-gray-200">
        <h2 class="text-xl font-bold text-gray-950 tracking-tight mb-4">
          Frequently Asked Questions
        </h2>
        <div class="space-y-3">
          {calc.faqs.map((faq) => (
            <details class="border border-gray-200 rounded-lg bg-white p-4 group">
              <summary class="font-semibold text-sm text-gray-900 cursor-pointer list-none flex items-center justify-between">
                <span>{faq.question}</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="mt-3 text-xs text-gray-700 leading-relaxed border-t border-gray-100 pt-3 m-0">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Next Calculation Steps / Related Calculators -->
    {relatedCalcs.length > 0 && (
      <section class="mt-12 pt-8 border-t border-gray-200">
        <h2 class="text-xl font-bold text-gray-950 tracking-tight mb-2">
          What to Calculate Next
        </h2>
        <p class="text-xs text-gray-500 mb-4">
          Freight planning connects sequentially from package dimensions to freight class, pallets, and full containers:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedCalcs.map((rc) => (
            <a
              href={rc.path}
              class="block p-4 border border-gray-200 rounded-lg bg-white hover:border-gray-950 transition-colors no-underline group shadow-2xs"
            >
              <span class="text-[10px] font-mono uppercase tracking-wider text-gray-400 block mb-1">
                {rc.category}
              </span>
              <span class="font-semibold text-sm text-gray-900 group-hover:text-blue-600 block mb-1">
                {rc.title} →
              </span>
              <span class="text-xs text-gray-500 line-clamp-2 leading-snug">
                {rc.shortDesc}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related Reference Guides -->
    {relatedGuides.length > 0 && (
      <section class="mt-12 pt-8 border-t border-gray-200 mb-12">
        <h2 class="text-xl font-bold text-gray-950 tracking-tight mb-2">
          Related Reference Guides
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedGuides.map((rg) => (
            <a
              href={rg.path}
              class="block p-4 border border-gray-200 rounded-lg bg-white hover:border-blue-600 transition-colors no-underline group shadow-2xs"
            >
              <div class="flex items-center justify-between text-[11px] text-gray-400 mb-1 font-mono">
                <span>{rg.category}</span>
                <span>{rg.readingTime}</span>
              </div>
              <span class="font-semibold text-sm text-gray-900 group-hover:text-blue-600 block mb-1">
                {rg.title} →
              </span>
              <span class="text-xs text-gray-500 line-clamp-2 leading-snug">
                {rg.summary}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
