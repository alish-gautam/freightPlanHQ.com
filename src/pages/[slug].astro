---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CalculatorShell from '../components/CalculatorShell.astro';
import { calculators, type CalculatorMeta } from '../lib/calculators/registry';
import { getGuideBySlug, type GuideMeta } from '../lib/guides/registry';
import { sourceById } from '../lib/sources';
import { site } from '../lib/site';

export function getStaticPaths() {
  return calculators.map((calc) => ({
    params: { slug: calc.slug },
    props: { calc },
  }));
}

export interface Props {
  calc: CalculatorMeta;
}

const { calc } = Astro.props;

// Prepare Schema.org JSON-LD
const webAppSchema = {
  '@type': 'WebApplication',
  name: calc.title,
  url: `${site.url}${calc.path}`,
  description: calc.metaDescription,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const faqSchema = calc.faqs.length
  ? {
      '@type': 'FAQPage',
      mainEntity: calc.faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    }
  : null;

const fullSchema = [webAppSchema, ...(faqSchema ? [faqSchema] : [])];

// Resolve related entities
const relatedCalcs = calc.relatedCalculators
  .map((slug) => calculators.find((c) => c.slug === slug))
  .filter((c): c is CalculatorMeta => Boolean(c));

const relatedGuides = calc.relatedGuides
  .map((slug) => getGuideBySlug(slug))
  .filter((g): g is GuideMeta => Boolean(g));

const resolvedSources = calc.sourceIds
  .map((id) => {
    try {
      return sourceById(id);
    } catch {
      return null;
    }
  })
  .filter(Boolean);
---

<Layout
  title={calc.metaTitle}
  description={calc.metaDescription}
  canonicalPath={calc.slug}
  schema={fullSchema}
>
  <!-- Top Breadcrumb Bar -->
  <div class="bg-canvas border-b border-hairline px-4 sm:px-6 lg:px-8 py-2.5">
    <div class="max-w-7xl mx-auto">
      <Breadcrumbs
        items={[
          { label: calc.category, href: `/#category-${calc.category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` },
          { label: calc.title },
        ]}
      />
    </div>
  </div>

  <!-- Intro & Title Header Block -->
  <section class="bg-canvas py-8 sm:py-10 border-b border-hairline" id="calc-intro">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <div class="inline-flex items-center gap-1.5 bg-canvas-elevated border border-hairline rounded-full px-3 py-1 text-xs text-mute shadow-2xs">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500 inline-block animate-pulse"></span>
          <span>Free Logistics Planning Tool</span>
        </div>
        <div class="inline-flex items-center gap-1.5 bg-canvas-elevated border border-hairline rounded-full px-3 py-1 text-xs text-mute shadow-2xs">
          <span class="font-medium text-ink">Category:</span>
          <span class="text-blue-600 dark:text-blue-400 font-semibold uppercase">{calc.category}</span>
        </div>
        {calc.flagship && (
          <span class="bg-blue-600 text-white px-2 py-0.5 rounded-full font-bold text-[10px] uppercase tracking-wider">
            Flagship
          </span>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-ink mb-3 tracking-tight leading-tight">
        {calc.h1}
      </h1>
      <p class="text-sm sm:text-base text-body max-w-3xl leading-relaxed m-0 mb-4">
        {calc.shortDesc}
      </p>

      <!-- Trust Strip -->
      <div class="flex flex-wrap items-center gap-4 text-xs text-mute pt-3 border-t border-hairline">
        <span class="flex items-center gap-1.5 font-medium text-ink">
          <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Instant calculation
        </span>
        <span class="w-1 h-1 rounded-full bg-hairline-strong"></span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Auditable formulas
        </span>
        <span class="w-1 h-1 rounded-full bg-hairline-strong"></span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Zero sign-up
        </span>
      </div>
    </div>
  </section>

  <!-- Main Calculator Surface (High on page) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <CalculatorShell slug={calc.slug} spec={calc.spec} />

    <!-- Technical Contextual Disclaimer -->
    <div class="border border-hairline bg-surface-subtle p-4 sm:p-5 rounded-xl text-xs text-body leading-relaxed my-8 flex items-start gap-3" role="note">
      <div class="w-5 h-5 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <div>
        <p class="font-bold uppercase tracking-wider text-[11px] text-ink m-0 mb-1">
          Planning Notice & Scope Boundary
        </p>
        <p class="m-0 text-mute">
          {calc.disclaimer}
        </p>
      </div>
    </div>

    <!-- Formula & Methodology -->
    <section class="mt-12 pt-8 border-t border-hairline">
      <div class="mb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
          Auditable Mathematics
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight m-0">
          Formula & Calculation Methodology
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-body leading-relaxed mb-4">
        {calc.formula.summary}
      </p>

      <div class="bg-surface-subtle border border-hairline rounded-xl p-4 sm:p-5 font-mono text-xs sm:text-sm text-ink overflow-x-auto my-4 shadow-2xs">
        <code>{calc.formula.latexOrCode}</code>
      </div>

      <div class="table-scroll my-4">
        <table class="data-table">
          <caption>Variable Definitions & Unit Basis</caption>
          <thead>
            <tr>
              <th scope="col" class="w-1/4">Variable</th>
              <th scope="col">Definition & Basis</th>
            </tr>
          </thead>
          <tbody>
            {calc.formula.variables.map((v) => (
              <tr>
                <th scope="row" class="font-mono font-bold text-ink">{v.symbol}</th>
                <td>{v.explanation}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Engine Audit Trail (Worked Example) -->
    <section class="mt-12 pt-8 border-t border-hairline">
      <div class="mb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
          Engine Audit Trail
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight m-0">
          Worked Example: {calc.workedExample.title}
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-body leading-relaxed mb-4">
        {calc.workedExample.scenario}
      </p>

      <div class="bg-canvas-elevated border border-hairline rounded-xl p-5 sm:p-6 mb-4 shadow-xs">
        <h3 class="text-xs font-bold uppercase tracking-wider text-mute mb-3 font-mono">
          Input Parameters
        </h3>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 list-none p-0 m-0 text-xs mb-6">
          {calc.workedExample.inputs.map((inp) => (
            <li class="bg-surface-subtle p-3 rounded-lg border border-hairline">
              <span class="block text-mute text-[11px] mb-0.5">{inp.label}</span>
              <span class="font-bold text-ink">{inp.value}</span>
            </li>
          ))}
        </ul>

        <h3 class="text-xs font-bold uppercase tracking-wider text-mute mb-3 font-mono">
          Step-by-Step Calculation Breakdown
        </h3>
        <ol class="space-y-2 text-xs text-body pl-0 list-none m-0 mb-6">
          {calc.workedExample.steps.map((st, idx) => (
            <li class="flex items-start gap-2.5 p-2.5 rounded-lg bg-surface-subtle border border-hairline">
              <span class="w-5 h-5 rounded-full bg-blue-500/15 text-blue-700 dark:text-blue-400 text-[10px] font-mono font-bold flex items-center justify-center shrink-0 mt-0.5">
                {idx + 1}
              </span>
              <span class="leading-relaxed">{st}</span>
            </li>
          ))}
        </ol>

        <div class="p-4 bg-surface-subtle border border-hairline rounded-lg flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-accent block mb-0.5">
              Verified Engine Result: {calc.workedExample.result.label}
            </span>
            <span class="text-xl sm:text-2xl font-extrabold text-ink">
              {calc.workedExample.result.value}
            </span>
          </div>
          {calc.workedExample.result.note && (
            <span class="text-xs text-mute sm:text-right max-w-xs">
              {calc.workedExample.result.note}
            </span>
          )}
        </div>
      </div>
    </section>

    <!-- Assumptions & Limitations -->
    <section class="mt-12 pt-8 border-t border-hairline grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-canvas-elevated border border-hairline rounded-xl p-5 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          <h2 class="text-base font-bold text-ink m-0">
            Assumptions Used
          </h2>
        </div>
        <ul class="space-y-2 text-xs text-body pl-4 m-0 leading-relaxed list-disc">
          {calc.assumptions.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="bg-canvas-elevated border border-hairline rounded-xl p-5 sm:p-6 shadow-xs">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <h2 class="text-base font-bold text-ink m-0">
            Important Limitations
          </h2>
        </div>
        <ul class="space-y-2 text-xs text-body pl-4 m-0 leading-relaxed list-disc">
          {calc.limitations.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Authoritative Sources -->
    {resolvedSources.length > 0 && (
      <section class="mt-12 pt-8 border-t border-hairline">
        <div class="mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
            Primary Documentation
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight m-0">
            Authoritative Standards & Sources
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {resolvedSources.map((s) => (
            <div class="border border-hairline rounded-xl p-4 sm:p-5 bg-canvas-elevated text-xs shadow-xs">
              <div class="flex items-center justify-between mb-1.5">
                <span class="font-bold text-ink">{s!.organization}</span>
                <span class="text-mute font-mono text-[10px] bg-surface-subtle px-2 py-0.5 rounded border border-hairline">
                  Verified: {s!.verified}
                </span>
              </div>
              <p class="font-semibold mb-1.5">
                <a href={s!.url} target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">
                  {s!.title} ↗
                </a>
              </p>
              <p class="text-mute m-0 text-[11px] leading-relaxed">
                {s!.notes}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Frequently Asked Questions -->
    {calc.faqs.length > 0 && (
      <section class="mt-12 pt-8 border-t border-hairline">
        <div class="mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
            Questions & Answers
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight m-0">
            Frequently Asked Questions
          </h2>
        </div>
        <div class="space-y-3">
          {calc.faqs.map((faq) => (
            <details class="group border border-hairline rounded-xl bg-canvas-elevated p-4 sm:p-5 shadow-2xs hover:border-hairline-strong transition-all">
              <summary class="font-bold text-sm text-ink cursor-pointer list-none flex items-center justify-between gap-4 select-none">
                <span>{faq.question}</span>
                <span class="text-mute group-open:rotate-180 transition-transform duration-200 shrink-0">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <p class="mt-3 text-xs sm:text-sm text-body leading-relaxed border-t border-hairline pt-3 m-0">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Next Calculation Steps / Related Calculators -->
    {relatedCalcs.length > 0 && (
      <section class="mt-12 pt-8 border-t border-hairline">
        <div class="mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
            Sequential Planning Flow
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight m-0">
            What to Calculate Next
          </h2>
        </div>
        <p class="text-xs text-mute mb-4">
          Freight planning connects sequentially from package dimensions to freight class, pallets, and full equipment:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedCalcs.map((rc) => (
            <a
              href={rc.path}
              class="block p-5 border border-hairline rounded-xl bg-canvas-elevated hover:border-ink transition-all no-underline group shadow-2xs"
            >
              <span class="text-[10px] font-mono uppercase tracking-wider text-mute block mb-1">
                {rc.category}
              </span>
              <span class="font-bold text-sm text-ink group-hover:text-blue-600 dark:group-hover:text-blue-400 block mb-1 transition-colors">
                {rc.title} →
              </span>
              <span class="text-xs text-mute line-clamp-2 leading-relaxed">
                {rc.shortDesc}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related Reference Guides -->
    {relatedGuides.length > 0 && (
      <section class="mt-12 pt-8 border-t border-hairline mb-12">
        <div class="mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
            Knowledge Base
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight m-0">
            Related Reference Guides
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedGuides.map((rg) => (
            <a
              href={rg.path}
              class="block p-5 border border-hairline rounded-xl bg-canvas-elevated hover:border-ink transition-all no-underline group shadow-2xs"
            >
              <div class="flex items-center justify-between text-[11px] text-mute mb-1.5 font-mono">
                <span>{rg.category}</span>
                <span>{rg.readingTime}</span>
              </div>
              <span class="font-bold text-sm text-ink group-hover:text-blue-600 dark:group-hover:text-blue-400 block mb-1 transition-colors">
                {rg.title} →
              </span>
              <span class="text-xs text-mute line-clamp-2 leading-relaxed">
                {rg.summary}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
