---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { BRAND_NAME, DOMAIN } from '../../lib/site';
---

<Layout
  title={`Contact & Feedback — ${BRAND_NAME}`}
  description={`Contact the engineering team behind ${BRAND_NAME} for calculation bug reports, source updates, and feedback.`}
  canonicalPath="contact"
>
  <!-- Top Breadcrumb Bar -->
  <div class="bg-canvas border-b border-hairline px-4 sm:px-6 lg:px-8 py-2.5">
    <div class="max-w-4xl mx-auto">
      <Breadcrumbs items={[{ label: 'Contact' }]} />
    </div>
  </div>

  <div class="container-narrow py-8 sm:py-12">
    <header class="mb-8">
      <div class="inline-flex items-center gap-1.5 bg-canvas-elevated border border-hairline rounded-full px-3 py-1 text-xs text-mute mb-3 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 inline-block animate-pulse"></span>
        <span class="font-mono uppercase tracking-wider font-semibold">FEEDBACK CHANNELS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink mb-3 leading-tight">
        Contact & Feedback
      </h1>
      <p class="text-sm sm:text-base text-body leading-relaxed max-w-2xl m-0">
        We welcome technical feedback, calculation bug reports, and updates to industry standards.
      </p>
    </header>

    <div class="space-y-8 text-sm text-body leading-relaxed">
      <section class="border-t border-hairline pt-6">
        <h2 class="text-xl font-bold text-ink mb-2">Technical Issues & Bug Reports</h2>
        <p>
          If you identify a numerical error, boundary discrepancy in our freight class engine, or an equipment specification that deviates from published ISO or container line standards, please submit a detailed report including:
        </p>
        <ul class="space-y-1.5 pl-5 mt-2 list-disc">
          <li>The specific calculator or guide URL</li>
          <li>Exact inputs used (dimensions, weights, quantities, units)</li>
          <li>The observed output versus your expected calculated output</li>
          <li>Citations to the relevant primary standard or published carrier tariff</li>
        </ul>
      </section>

      <section class="border-t border-hairline pt-6">
        <h2 class="text-xl font-bold text-ink mb-2">Standard Inquiries & Domain Activation</h2>
        <p>
          For general questions regarding the calculation methodology or to suggest new equipment presets, inquiries are managed through the primary domain contact channels for <code>{DOMAIN}</code>.
        </p>
        <div class="p-4 rounded-xl bg-surface-subtle border border-hairline text-xs text-mute font-mono mt-4 space-y-2">
          <div><strong class="text-ink">Domain Launch Status:</strong> Dedicated support email routing (<code>inquiries@{DOMAIN.toLowerCase()}</code>) is scheduled for immediate activation following final domain DNS and MX record provisioning.</div>
          <div><strong class="text-ink">Scope Limitation:</strong> {BRAND_NAME} is an engineering calculation platform. We cannot provide commercial freight rate quotes, book cargo, or answer questions regarding specific carrier shipments in transit.</div>
        </div>
      </section>
    </div>
  </div>
</Layout>
