---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { guides, type GuideMeta } from '../../lib/guides/registry';
import { calculators } from '../../lib/calculators/registry';
import { sourceById } from '../../lib/sources';
import { site } from '../../lib/site';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

export interface Props {
  guide: GuideMeta;
}

const { guide } = Astro.props;

// Prepare Article structured data
const articleSchema = {
  '@type': 'Article',
  headline: guide.h1,
  description: guide.metaDescription,
  datePublished: '2026-10-06T00:00:00Z',
  dateModified: `${guide.lastVerified}T00:00:00Z`,
  author: {
    '@type': 'Organization',
    name: site.brandName,
    url: site.url,
  },
  publisher: {
    '@type': 'Organization',
    name: site.brandName,
    url: site.url,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${site.url}${guide.path}`,
  },
};

// Resolve related tools & guides
const relatedCalcs = guide.relatedCalculators
  .map((slug) => calculators.find((c) => c.slug === slug))
  .filter((c): c is (typeof calculators)[number] => Boolean(c));

const relatedGuides = guide.relatedGuides
  .map((slug) => guides.find((g) => g.slug === slug))
  .filter((g): g is (typeof guides)[number] => Boolean(g));

const resolvedSources = guide.sourceIds
  .map((id) => {
    try {
      return sourceById(id);
    } catch {
      return null;
    }
  })
  .filter(Boolean);
---

<Layout
  title={guide.metaTitle}
  description={guide.metaDescription}
  canonicalPath={`guides/${guide.slug}`}
  type="article"
  schema={articleSchema}
>
  <!-- Breadcrumb Bar -->
  <div class="bg-canvas border-b border-hairline px-4 sm:px-6 lg:px-8 py-2.5">
    <div class="max-w-4xl mx-auto">
      <Breadcrumbs
        items={[
          { label: 'Guides', href: '/guides/' },
          { label: guide.title },
        ]}
      />
    </div>
  </div>

  <div class="container-narrow py-8 sm:py-12">
    <!-- Header Block -->
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-mute uppercase tracking-wider mb-3">
        <span class="font-bold text-accent bg-surface-subtle px-2 py-0.5 rounded border border-hairline">
          {guide.category}
        </span>
        <span>·</span>
        <span>{guide.readingTime}</span>
        <span>·</span>
        <span>Verified {guide.lastVerified}</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-ink mb-4 leading-tight">
        {guide.h1}
      </h1>
      <div class="p-4 rounded-xl bg-surface-subtle border-l-4 border-blue-600 text-sm sm:text-base text-body leading-relaxed">
        {guide.summary}
      </div>
    </header>

    <!-- Guide Content Sections -->
    <article class="space-y-10 text-body text-sm leading-relaxed">
      {guide.sections.map((section) => (
        <section class="border-t border-hairline pt-6">
          <h2 class="text-xl font-bold text-ink tracking-tight mb-3">
            {section.title}
          </h2>
          <div class="space-y-3 whitespace-pre-line text-body leading-relaxed">
            {section.content}
          </div>

          {section.table && (
            <div class="table-scroll my-5">
              <table class="data-table">
                <caption>{section.table.caption}</caption>
                <thead>
                  <tr>
                    {section.table.head.map((h) => (
                      <th scope="col">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr>
                      {row.map((cell, idx) => (
                        idx === 0 ? <th scope="row" class="font-bold text-ink">{cell}</th> : <td>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      ))}
    </article>

    <!-- Primary Source References -->
    {resolvedSources.length > 0 && (
      <section class="mt-12 pt-8 border-t border-hairline">
        <div class="mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
            Authoritative Basis
          </span>
          <h2 class="text-xl font-bold text-ink tracking-tight m-0">
            Standards & References
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {resolvedSources.map((s) => (
            <div class="border border-hairline rounded-xl p-4 bg-canvas-elevated text-xs shadow-xs">
              <div class="flex items-center justify-between mb-1">
                <span class="font-bold text-ink">{s!.organization}</span>
                <span class="text-mute font-mono text-[10px] bg-surface-subtle px-1.5 py-0.5 rounded border border-hairline">
                  Verified: {s!.verified}
                </span>
              </div>
              <p class="font-semibold mb-1">
                <a href={s!.url} target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">
                  {s!.title} ↗
                </a>
              </p>
              <p class="text-mute m-0 text-[11px] leading-relaxed">
                {s!.notes}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Interactive Tools Linked -->
    {relatedCalcs.length > 0 && (
      <section class="mt-12 pt-8 border-t border-hairline">
        <div class="mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
            Interactive Calculators
          </span>
          <h2 class="text-xl font-bold text-ink tracking-tight m-0">
            Calculate This Topic
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedCalcs.map((rc) => (
            <a
              href={rc!.path}
              class="block p-5 border border-hairline rounded-xl bg-canvas-elevated hover:border-ink transition-all no-underline group shadow-xs"
            >
              <span class="text-[10px] font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-bold block mb-1">
                {rc!.category}
              </span>
              <span class="font-bold text-base text-ink group-hover:text-blue-600 dark:group-hover:text-blue-400 block mb-1 transition-colors">
                {rc!.title} &rarr;
              </span>
              <span class="text-xs text-mute line-clamp-2 leading-relaxed">
                {rc!.shortDesc}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related Reference Guides -->
    {relatedGuides.length > 0 && (
      <section class="mt-12 pt-8 border-t border-hairline mb-8">
        <div class="mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
            Further Reading
          </span>
          <h2 class="text-xl font-bold text-ink tracking-tight m-0">
            Related Guides
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedGuides.map((rg) => (
            <a
              href={rg!.path}
              class="block p-4 border border-hairline rounded-xl bg-canvas-elevated hover:border-ink transition-all no-underline group shadow-2xs"
            >
              <div class="flex items-center justify-between text-[11px] text-mute mb-1 font-mono">
                <span>{rg!.category}</span>
                <span>{rg!.readingTime}</span>
              </div>
              <span class="font-semibold text-sm text-ink group-hover:text-blue-600 dark:group-hover:text-blue-400 block mb-1 transition-colors">
                {rg!.title} &rarr;
              </span>
              <span class="text-xs text-mute line-clamp-2 leading-snug">
                {rg!.summary}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
