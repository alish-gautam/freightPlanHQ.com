---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { guides, type GuideMeta } from '../../lib/guides/registry';
import { calculators } from '../../lib/calculators/registry';
import { sourceById } from '../../lib/sources';
import { site } from '../../lib/site';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

export interface Props {
  guide: GuideMeta;
}

const { guide } = Astro.props;

// Prepare Article structured data
const articleSchema = {
  '@type': 'Article',
  headline: guide.h1,
  description: guide.metaDescription,
  datePublished: '2026-10-06T00:00:00Z',
  dateModified: `${guide.lastVerified}T00:00:00Z`,
  author: {
    '@type': 'Organization',
    name: site.brandName,
    url: site.url,
  },
  publisher: {
    '@type': 'Organization',
    name: site.brandName,
    url: site.url,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${site.url}${guide.path}`,
  },
};

// Resolve related tools & guides
const relatedCalcs = guide.relatedCalculators
  .map((slug) => calculators.find((c) => c.slug === slug))
  .filter((c): c is (typeof calculators)[number] => Boolean(c));

const relatedGuides = guide.relatedGuides
  .map((slug) => guides.find((g) => g.slug === slug))
  .filter((g): g is (typeof guides)[number] => Boolean(g));

const resolvedSources = guide.sourceIds
  .map((id) => {
    try {
      return sourceById(id);
    } catch {
      return null;
    }
  })
  .filter(Boolean);
---

<Layout
  title={guide.metaTitle}
  description={guide.metaDescription}
  canonicalPath={`guides/${guide.slug}`}
  type="article"
  schema={articleSchema}
>
  <div class="container-narrow py-6 sm:py-10">
    <!-- Breadcrumb -->
    <Breadcrumbs
      items={[
        { label: 'Guides', href: '/guides/' },
        { label: guide.title },
      ]}
    />

    <!-- Header Block -->
    <header class="mt-4 mb-8">
      <div class="flex items-center gap-2 text-xs font-mono text-gray-500 uppercase tracking-wider mb-2">
        <span>{guide.category}</span>
        <span>·</span>
        <span>{guide.readingTime}</span>
        <span>·</span>
        <span>Verified {guide.lastVerified}</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-gray-950 mb-4">
        {guide.h1}
      </h1>
      <p class="text-base text-gray-600 leading-relaxed max-w-3xl border-l-2 border-gray-900 pl-4 py-1 m-0 bg-gray-50">
        {guide.summary}
      </p>
    </header>

    <!-- Guide Content Sections -->
    <article class="prose max-w-none space-y-8 text-gray-800 text-sm leading-relaxed">
      {guide.sections.map((section) => (
        <section class="border-t border-gray-200 pt-6">
          <h2 class="text-xl font-bold text-gray-950 tracking-tight mb-3">
            {section.title}
          </h2>
          <div class="space-y-3 whitespace-pre-line text-gray-700 leading-relaxed">
            {section.content}
          </div>

          {section.table && (
            <div class="table-scroll my-4">
              <table class="data-table">
                <caption>{section.table.caption}</caption>
                <thead>
                  <tr>
                    {section.table.head.map((h) => (
                      <th scope="col">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr>
                      {row.map((cell, idx) => (
                        idx === 0 ? <th scope="row" class="font-medium text-gray-950">{cell}</th> : <td>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      ))}
    </article>

    <!-- Primary Source References -->
    {resolvedSources.length > 0 && (
      <section class="mt-12 pt-8 border-t border-gray-200">
        <h2 class="text-lg font-bold text-gray-950 tracking-tight mb-3">
          Authoritative Standards & References
        </h2>
        <div class="space-y-3">
          {resolvedSources.map((s) => (
            <div class="border border-gray-200 rounded-lg p-4 bg-white text-xs">
              <div class="flex items-center justify-between mb-1">
                <span class="font-semibold text-gray-900">{s!.organization}</span>
                <span class="text-gray-400 font-mono text-[11px]">Last verified: {s!.verified}</span>
              </div>
              <p class="text-gray-700 font-medium mb-1">
                <a href={s!.url} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
                  {s!.title} ↗
                </a>
              </p>
              <p class="text-gray-500 m-0 text-[11px]">
                {s!.notes}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Interactive Tools Linked -->
    {relatedCalcs.length > 0 && (
      <section class="mt-12 pt-8 border-t border-gray-200">
        <h2 class="text-xl font-bold text-gray-950 tracking-tight mb-2">
          Interactive Calculators for This Topic
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedCalcs.map((rc) => (
            <a
              href={rc!.path}
              class="block p-5 border border-gray-300 rounded-lg bg-white hover:border-gray-950 transition-colors no-underline group shadow-xs"
            >
              <span class="text-[10px] font-mono uppercase tracking-wider text-blue-600 font-semibold block mb-1">
                Calculator
              </span>
              <span class="font-bold text-base text-gray-950 group-hover:text-blue-600 block mb-1">
                {rc!.title} →
              </span>
              <span class="text-xs text-gray-600 line-clamp-2 leading-relaxed">
                {rc!.shortDesc}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related Reference Guides -->
    {relatedGuides.length > 0 && (
      <section class="mt-12 pt-8 border-t border-gray-200 mb-12">
        <h2 class="text-xl font-bold text-gray-950 tracking-tight mb-2">
          Related Guides
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedGuides.map((rg) => (
            <a
              href={rg!.path}
              class="block p-4 border border-gray-200 rounded-lg bg-white hover:border-gray-950 transition-colors no-underline group shadow-2xs"
            >
              <div class="flex items-center justify-between text-[11px] text-gray-400 mb-1 font-mono">
                <span>{rg!.category}</span>
                <span>{rg!.readingTime}</span>
              </div>
              <span class="font-semibold text-sm text-gray-900 group-hover:text-blue-600 block mb-1">
                {rg!.title} →
              </span>
              <span class="text-xs text-gray-500 line-clamp-2 leading-snug">
                {rg!.summary}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
