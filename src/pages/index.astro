---
import Layout from '../layouts/Layout.astro';
import { calculators } from '../lib/calculators/registry';
import { guides } from '../lib/guides/registry';
import { site } from '../lib/site';

const featuredSlugs = [
  'freight-class-calculator',
  'cbm-calculator',
  'pallet-calculator',
  'dimensional-weight-calculator',
  'container-loading-calculator',
];

const featuredCalcs = featuredSlugs
  .map((s) => calculators.find((c) => c.slug === s))
  .filter(Boolean);

const workflowSteps = [
  { step: '01', title: 'Measure Package', desc: 'Outer length, width, height, and gross weight', link: '/box-volume-calculator/' },
  { step: '02', title: 'Calculate Volume', desc: 'CBM and cubic feet across SKUs', link: '/cbm-calculator/' },
  { step: '03', title: 'Calculate Density', desc: 'Pounds per cubic foot (PCF) and kg/m³', link: '/freight-density-calculator/' },
  { step: '04', title: 'Build Pallets', desc: 'TI × HI layer geometry, tare, and height', link: '/pallet-calculator/' },
  { step: '05', title: 'Check DIM Weight', desc: 'Billable weight across carrier divisors', link: '/dimensional-weight-calculator/' },
  { step: '06', title: 'Plan Mode', desc: 'LTL freight class, air chargeable weight, or ocean W/M', link: '/freight-class-calculator/' },
  { step: '07', title: 'Fill Equipment', desc: '3D container loading, LDM, or trailer linear feet', link: '/container-loading-calculator/' },
];

const categories = [
  {
    id: 'freight',
    tag: 'FREIGHT',
    name: 'Freight & Classification',
    desc: 'Volume, density, and 13-sub LTL classification for North American and global freight.',
    slugs: ['freight-class-calculator', 'cbm-calculator', 'freight-density-calculator'],
  },
  {
    id: 'pallets',
    tag: 'PALLETS',
    name: 'Pallets & Stacking',
    desc: 'Stacking patterns, TI × HI layers, overhang tolerances, and container floor arrangements.',
    slugs: ['pallet-calculator', 'pallets-per-container-calculator'],
  },
  {
    id: 'packaging',
    tag: 'PACKAGING',
    name: 'Packaging & Cartons',
    desc: 'Carton sizing, void reduction, package girth, and dimensional weight comparison.',
    slugs: ['dimensional-weight-calculator', 'box-size-calculator', 'box-volume-calculator', 'package-girth-calculator'],
  },
  {
    id: 'air-ocean',
    tag: 'AIR & OCEAN',
    name: 'Air Cargo & Ocean Freight',
    desc: 'IATA 1:6000 air cargo volumetric weight and ocean LCL Weight or Measure (W/M) revenue tons.',
    slugs: ['air-freight-chargeable-weight-calculator', 'lcl-freight-calculator'],
  },
  {
    id: 'containers-trailers',
    tag: 'CONTAINERS & TRAILERS',
    name: 'Containers & Trailers',
    desc: 'Deterministic 3D container packing heuristics, European loading meters (LDM), and North American linear feet.',
    slugs: ['container-loading-calculator', 'loading-meter-calculator', 'linear-feet-calculator'],
  },
];
---

<Layout
  title={site.title}
  description={site.description}
  canonicalPath=""
>
  <!-- Hero Section: Workflow & Utility Focused -->
  <section class="py-10 sm:py-16 px-4 sm:px-6 lg:px-8 border-b border-hairline bg-canvas transition-colors" id="hero">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 bg-canvas-elevated border border-hairline rounded-full px-3.5 py-1 text-xs text-mute mb-5 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse inline-block"></span>
        <span class="font-mono uppercase tracking-wider font-semibold">FREIGHT & PACKAGING PLANNING</span>
      </div>

      <!-- Main Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-ink mb-4 leading-tight">
        Freight & Packaging Planning Tools
      </h1>

      <!-- Subtitle -->
      <p class="text-sm sm:text-base md:text-lg text-body max-w-2xl mx-auto mb-6 leading-relaxed font-normal">
        A disciplined suite of engineering calculators for measuring cargo, right-sizing packaging, building pallet layers, and calculating trailer and container utilization before requesting carrier quotations.
      </p>

      <!-- Trust Badges Strip -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 bg-canvas-elevated px-5 sm:px-7 py-2.5 rounded-full border border-hairline shadow-xs max-w-fit mx-auto text-xs sm:text-sm font-semibold text-ink">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Free
        </span>
        <span class="hidden sm:inline w-px h-3.5 bg-hairline-strong"></span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          No Sign-Up
        </span>
        <span class="hidden sm:inline w-px h-3.5 bg-hairline-strong"></span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Transparent Calculations
        </span>
        <span class="hidden sm:inline w-px h-3.5 bg-hairline-strong"></span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Source-Referenced
        </span>
      </div>
    </div>
  </section>

  <!-- Featured Calculators Grid (Top 5 Priority Tools) -->
  <section class="py-10 sm:py-14 px-4 sm:px-6 lg:px-8 bg-canvas border-b border-hairline" id="featured-tools">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 pb-3 border-b border-hairline gap-2">
        <div>
          <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider block mb-1">
            Priority Tools
          </span>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-ink tracking-tight m-0">
            Featured Planning Calculators
          </h2>
        </div>
        <span class="text-xs text-mute font-mono uppercase tracking-wider bg-canvas-elevated px-3 py-1 rounded-lg border border-hairline self-start sm:self-auto font-medium">
          14 Dedicated Utilities
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {featuredCalcs.map((calc) => (
          <a
            href={calc!.path}
            class="block group no-underline"
            id={`card-${calc!.slug}`}
          >
            <div class="h-full bg-canvas-elevated border border-hairline rounded-xl p-5 sm:p-6 flex flex-col justify-between hover:border-ink transition-all duration-200 shadow-xs">
              <div>
                <div class="flex items-start justify-between mb-4">
                  <div class="w-10 h-10 rounded-lg bg-surface-subtle flex items-center justify-center text-ink group-hover:bg-blue-600 group-hover:text-white transition-all duration-200 shadow-2xs">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                      <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                      <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                      <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                    </svg>
                  </div>
                  <span class="text-[10px] font-mono font-bold tracking-wider text-mute bg-surface-subtle px-2.5 py-0.5 rounded-full uppercase">
                    {calc!.category}
                  </span>
                </div>

                <h3 class="text-base sm:text-lg font-bold text-ink mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
                  {calc!.title}
                </h3>
                <p class="text-xs sm:text-sm text-body leading-relaxed mb-4 line-clamp-3">
                  {calc!.shortDesc}
                </p>
              </div>

              <div class="pt-3 border-t border-hairline flex items-center justify-between text-xs">
                <span class="text-mute font-medium flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                  </svg>
                  Source-Documented
                </span>
                <span class="font-bold text-ink group-hover:text-blue-600 dark:group-hover:text-blue-400 group-hover:translate-x-1 transition-all flex items-center gap-1">
                  Calculate now &rarr;
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7-Step Planning Pipeline -->
  <section class="py-10 sm:py-12 px-4 sm:px-6 lg:px-8 border-b border-hairline bg-surface-subtle transition-colors">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-bold block mb-0.5">
            Sequential Workflow
          </span>
          <h2 class="text-lg sm:text-xl font-bold text-ink m-0">
            How Freight Planning Connects Sequentially
          </h2>
        </div>
        <span class="hidden sm:inline-block text-xs text-mute font-mono">
          Carton → Pallet → Equipment
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
        {workflowSteps.map((step) => (
          <a
            href={step.link}
            class="block p-3.5 bg-canvas-elevated border border-hairline rounded-lg hover:border-ink transition-colors no-underline group shadow-2xs"
          >
            <span class="text-[11px] font-mono font-bold text-blue-600 dark:text-blue-400 block mb-1">
              {step.step}
            </span>
            <span class="text-xs font-bold text-ink group-hover:text-blue-600 dark:group-hover:text-blue-400 block mb-1 leading-snug">
              {step.title}
            </span>
            <span class="text-[11px] text-mute line-clamp-2 leading-snug">
              {step.desc}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Full Suite Categorized Directory -->
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-canvas" id="calculators-suite">
    <div class="max-w-7xl mx-auto space-y-12">
      {categories.map((cat) => (
        <div id={`category-${cat.id}`}>
          <div class="mb-5 border-b border-hairline pb-3 flex flex-col sm:flex-row sm:items-end justify-between gap-1">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-0.5">
                {cat.tag}
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-ink tracking-tight m-0">
                {cat.name}
              </h3>
            </div>
            <p class="text-xs text-mute m-0 max-w-md">
              {cat.desc}
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {cat.slugs.map((slug) => {
              const c = calculators.find((item) => item.slug === slug);
              if (!c) return null;
              return (
                <a
                  href={c.path}
                  class="block group no-underline"
                  id={`card-cat-${c.slug}`}
                >
                  <div class="h-full bg-canvas-elevated border border-hairline rounded-xl p-5 flex flex-col justify-between hover:border-ink transition-all shadow-xs">
                    <div>
                      <div class="flex items-center justify-between mb-3">
                        <span class="text-[10px] font-mono font-bold text-blue-600 dark:text-blue-400 bg-blue-500/10 px-2.5 py-0.5 rounded-full border border-blue-500/20 uppercase">
                          {cat.tag}
                        </span>
                        {c.flagship && (
                          <span class="text-[9px] font-bold uppercase bg-blue-600 text-white px-1.5 py-0.2 rounded">
                            Flagship
                          </span>
                        )}
                      </div>
                      <h4 class="text-base font-bold text-ink mb-1.5 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                        {c.title}
                      </h4>
                      <p class="text-xs text-body leading-relaxed mb-4 line-clamp-2">
                        {c.shortDesc}
                      </p>
                    </div>

                    <div class="pt-3 border-t border-hairline flex items-center justify-between text-xs font-bold text-blue-600 dark:text-blue-400">
                      <span>Launch Tool</span>
                      <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Guides & Documentation -->
  <section class="py-12 border-t border-hairline bg-canvas-elevated px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-hairline">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-bold block mb-0.5">
            Reference Documentation
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight m-0">
            Featured Freight & Packaging Guides
          </h2>
        </div>
        <a href="/guides/" class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400 hover:underline">
          View all 18 guides &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {guides.slice(0, 6).map((g) => (
          <a
            href={g.path}
            class="block p-5 border border-hairline rounded-xl bg-canvas hover:border-ink transition-colors no-underline group shadow-2xs"
          >
            <div class="flex items-center justify-between text-[11px] text-mute mb-2 font-mono">
              <span>{g.category}</span>
              <span>{g.readingTime}</span>
            </div>
            <h3 class="text-sm font-bold text-ink group-hover:text-blue-600 dark:group-hover:text-blue-400 mb-1.5 leading-snug">
              {g.title} &rarr;
            </h3>
            <p class="text-xs text-body line-clamp-2 m-0 leading-relaxed">
              {g.summary}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
