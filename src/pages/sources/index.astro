---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { sources } from '../../lib/sources';
---

<Layout
  title="Primary Standards & Sources Registry — FreightPlanHQ"
  description="Transparent directory of industry standards, carrier reference rules, and equipment specifications used across our calculators."
  canonicalPath="sources"
>
  <!-- Top Breadcrumb Bar -->
  <div class="bg-canvas border-b border-hairline px-4 sm:px-6 lg:px-8 py-2.5">
    <div class="max-w-4xl mx-auto">
      <Breadcrumbs items={[{ label: 'Sources' }]} />
    </div>
  </div>

  <div class="container-narrow py-8 sm:py-12">
    <header class="mb-8">
      <div class="inline-flex items-center gap-1.5 bg-canvas-elevated border border-hairline rounded-full px-3 py-1 text-xs text-mute mb-3 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 inline-block animate-pulse"></span>
        <span class="font-mono uppercase tracking-wider font-semibold">PRIMARY STANDARDS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink mb-3 leading-tight">
        Standards & Sources Registry
      </h1>
      <p class="text-sm sm:text-base text-body leading-relaxed max-w-2xl m-0">
        Every rule-sensitive parameter, container dimension, and freight class tier on this platform references a recorded industry source.
      </p>
    </header>

    <div class="space-y-6">
      {sources.map((s) => (
        <div class="border border-hairline rounded-xl bg-canvas-elevated p-5 sm:p-6 shadow-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-hairline gap-2 mb-3">
            <div>
              <span class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-bold block">
                {s.topic}
              </span>
              <h2 class="text-base font-bold text-ink m-0">
                {s.organization}
              </h2>
            </div>
            <div class="text-[11px] font-mono text-mute sm:text-right">
              <div>Type: {s.type}</div>
              <div>Verified: {s.verified}</div>
            </div>
          </div>

          <p class="font-semibold text-sm mb-3">
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">
              {s.title} ↗
            </a>
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-body my-3">
            <div>
              <span class="font-bold text-ink block mb-0.5">Applicability:</span>
              <p class="m-0 leading-relaxed text-mute">{s.applicability}</p>
            </div>
            <div>
              <span class="font-bold text-ink block mb-0.5">Important Limitations:</span>
              <p class="m-0 leading-relaxed text-mute">{s.limitation}</p>
            </div>
          </div>

          <div class="bg-surface-subtle rounded-lg p-3 text-[11px] text-mute font-mono mt-3 border border-hairline">
            <span class="text-ink font-semibold">Verification Method:</span> {s.verificationMethod}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
